# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# .env.local 은 깃에 올라가지 않아요.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 검수 워커 전용 비밀 키 (service_role). 절대 NEXT_PUBLIC_ 을 붙이거나 화면 코드에서 쓰지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (게임 파일 저장소)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=minigame-games

# 게임 파일이 공개되는 주소. 메인 사이트와 다른 도메인이어야 해요 (예: https://play.내도메인.com)
NEXT_PUBLIC_GAME_ORIGIN=https://play.example.com

# 메인 사이트 주소 (리더보드 SDK 안내 문구에 쓰여요)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
